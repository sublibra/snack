# Database
DATABASE_URL=postgresql://snack_user:snack_password@localhost:5432/snack_db

# Notes:
# - By default this example points to a Postgres instance on localhost:5432 which
#   is suitable when you run Postgres on your host machine (for example via
#   your OS package manager or Homebrew).
# - This repo also includes a Docker Compose configuration which defines a
#   `db` service. If you prefer to run Postgres in Docker, start it with:
#
#     make db-up
#
#   That command will run the `db` container and map container port 5432 to the
#   host. You can then run the backend on the host (make run) and it will connect
#   to the DB at localhost:5432.
#
# - To run the entire stack (DB + backend) inside Docker, use:
#
#     docker-compose up -d
#
# - If you use Docker Compose's backend service, it uses the internal host name
#   `db` for DATABASE_URL (see docker-compose.yml). You don't need to change
#   `.env` when running `docker-compose up` because the container's environment
#   is configured in `docker-compose.yml`.

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# File Upload
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]